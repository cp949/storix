PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=storix
DB_PASSWORD=storix
DB_NAME=storix

# MinIO 대신 VersityGW로 백엔드가 바뀌어도 이 값들 말고는 아무것도
# 안 바뀐다는 걸 보여주는 예제가 docker-compose.versity-demo.yml에 있다
# (ADR-0012). .env는 그대로 두고 아래 override 파일로만 전환한다:
#   docker compose -f docker-compose.yml -f docker-compose.versity-demo.yml up
#
# 실제 AWS S3를 백엔드로 붙이는 예제는 docker-compose.s3-demo.yml에 있다
# (사전 준비·필요한 추가 변수는 그 파일 상단 주석 참고):
#   docker compose -f docker-compose.yml -f docker-compose.s3-demo.yml up
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=storix
STORAGE_SECRET_KEY=storix-secret
STORAGE_BUCKET=storix
# MinIO/self-host 기본값 true(path-style). AWS S3를 virtual-hosted-style로 붙일 때만 false로 설정한다.
STORAGE_PATH_STYLE=true
STORAGE_REGION=
# nginx-demo profile(STORAGE-03)로 app을 컨테이너 실행할 때는 비워두면 안 된다 —
# presigned URL 발급이 리전 자동 조회를 시도하다 컨테이너 자기 자신의 loopback으로
# 되돌아가 500난다. 예: STORAGE_REGION=us-east-1

# docker-compose.s3-demo.yml 전용 — 위 STORAGE_* 대신 이 값들을 쓴다(이유는
# 그 파일 상단 주석 참고). s3-demo를 안 쓰면 비워둬도 된다.
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# presigned download URL 발급용 — 외부에서 접근 가능한 주소를 넣는다. 내부용
# STORAGE_ENDPOINT와 같은 값을 쓰면 서명된 URL의 host가 내부 전용 이름이 되어
# 외부에서 못 찾는다(STORAGE-03의 nginx reverse-proxy 샘플과 짝을 이룬다).
STORAGE_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_PORT=9000
STORAGE_PUBLIC_USE_SSL=false
# STORAGE-03 nginx reverse-proxy 샘플(docs/deployment/nginx-reverse-proxy.md)을 쓸 때만
# 필요 — docker compose --profile nginx-demo 로 기동한다. 호스트에 노출할 포트.
NGINX_PUBLIC_PORT=8443

MAX_FILE_SIZE_BYTES=5368709120
MAX_SYNC_DELETE_NODES=1000
MAX_SYNC_COPY_NODES=1000
# presigned download URL 만료 시간(초). 기본 300초. MinIO SDK(SigV4) 상한인
# 604800초(7일)를 초과하면 API 서버가 부팅 시 오류를 내며 종료된다.
PRESIGNED_URL_EXPIRY_SECONDS=300
ORPHAN_GRACE_PERIOD=86400

# 서비스 간 인증 — openssl rand -hex 32 로 생성한 값을 사용한다.
API_KEY=
# 키 로테이션 중에만 설정한다 — 이 값과 API_KEY 둘 다 유효한 키로 인정된다.
API_KEY_PREVIOUS=

# ENCRYPTED namespace를 하나라도 쓰려면 필수. openssl rand -hex 32 로 생성한 값을 사용한다.
# 이 값을 분실하면 ENCRYPTED namespace의 데이터를 영구적으로 복호화할 수 없다.
ENCRYPTION_MASTER_KEY=

# 설정하면 500 에러/GC job 실패를 Sentry로 리포팅한다(self-hosted Sentry/SaaS 둘 다
# DSN 방식으로 지원). 비워두면 아무 것도 하지 않는 NoopErrorReporter가 대신 쓰인다.
# 요청 헤더·바디·쿼리스트링은 전송하지 않는다(sendDefaultPii: false 고정).
SENTRY_DSN=
# Prometheus 메트릭(/metrics)은 /health와 동일하게 무인증·상시 노출되며 끄고 켜는
# env var가 없다.

# 백업 대상 로컬 디렉터리 — profiles: ['backup']로 backup 서비스를 실행할 때
# 사용한다. 실행마다 {BACKUP_DIR}/{ISO8601 타임스탬프}/ 아래에 postgres.dump +
# minio/ 미러를 남긴다. 오프호스트 반출과 보존(retention) 관리는 운영자
# 책임이다(OPS-02 ADR 참고).
BACKUP_DIR=/backups
# profiles: ['restore']로 restore 서비스를 실행할 때 필수 — 위 BACKUP_DIR
# 아래 특정 백업 디렉터리(예: /backups/2026-09-08T12-00-00-000Z)를 가리킨다.
RESTORE_SOURCE_DIR=
# 복구 대상에 이미 namespace 데이터가 있으면 restore가 기본적으로 거부한다.
# 의도적으로 덮어쓰려면 true로 설정한다 — 기존 Postgres/MinIO 데이터가 전부
# 지워지고 백업 시점 상태로 교체된다(되돌릴 수 없음).
RESTORE_FORCE=false
