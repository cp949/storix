PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=storix
DB_PASSWORD=storix
DB_NAME=storix

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=storix
MINIO_SECRET_KEY=storix-secret
MINIO_BUCKET=storix
# MinIO/self-host 기본값 true(path-style). AWS S3를 virtual-hosted-style로 붙일 때만 false로 설정한다.
MINIO_PATH_STYLE=true
MINIO_REGION=

# presigned download URL 발급용 — 외부에서 접근 가능한 주소를 넣는다. 내부용
# MINIO_ENDPOINT와 같은 값을 쓰면 서명된 URL의 host가 내부 전용 이름이 되어
# 외부에서 못 찾는다(STORAGE-03의 nginx reverse-proxy 샘플과 짝을 이룬다).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

MAX_FILE_SIZE_BYTES=5368709120
MAX_SYNC_DELETE_NODES=1000
MAX_SYNC_COPY_NODES=1000
# presigned download URL 만료 시간(초). 기본 300초. MinIO SDK(SigV4) 상한인
# 604800초(7일)를 초과하면 API 서버가 부팅 시 오류를 내며 종료된다.
PRESIGNED_URL_EXPIRY_SECONDS=300
ORPHAN_GRACE_PERIOD=86400

# 서비스 간 인증 — openssl rand -hex 32 로 생성한 값을 사용한다.
API_KEY=
# 키 로테이션 중에만 설정한다 — 이 값과 API_KEY 둘 다 유효한 키로 인정된다.
API_KEY_PREVIOUS=

# ENCRYPTED namespace를 하나라도 쓰려면 필수. openssl rand -hex 32 로 생성한 값을 사용한다.
# 이 값을 분실하면 ENCRYPTED namespace의 데이터를 영구적으로 복호화할 수 없다.
ENCRYPTION_MASTER_KEY=
