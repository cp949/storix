# ---------------------------------------------------------------------------
# 실행 조합
#
# docker-compose.yml(base)은 API 서버와 운영 잡만 정의하고, DB·스토리지는 아래
# 접속 정보로 외부 서비스에 붙는다. 컨테이너를 추가하려면 override 파일을 -f로
# 겹친다:
#   docker-compose.versitygw.yml  VersityGW 컨테이너 (목표 기본 백엔드)
#   docker-compose.s3.yml         AWS S3 (컨테이너 없음, 접속값만 고정)
#   docker-compose.postgres.yml   개발·검증용 Postgres 컨테이너
#
#   docker compose -f docker-compose.yml -f docker-compose.versitygw.yml -f docker-compose.postgres.yml up -d
#
# docker compose는 아래 COMPOSE_FILE을 이 파일에서 읽어 -f 나열을 대신한다.
# podman-compose는 .env의 COMPOSE_FILE을 읽지 않으므로 쉘에서 export한다.
# 주석을 풀고 원하는 조합으로 바꾼다.
#COMPOSE_FILE=docker-compose.yml:docker-compose.versitygw.yml:docker-compose.postgres.yml
#
# 이름 규칙(docs/adr/0005-env-var-storix-prefix.md): Storix가 정의한 변수는 전부
# STORIX_ 접두어를 쓴다. 외부 규약인 COMPOSE_FILE(compose)·NODE_ENV(Node)만 예외다.
# 이 .env를 다른 프로젝트의 compose와 합치거나 셸에 export해도 다른 앱의
# DB_HOST/API_KEY/PORT와 섞이지 않는다.
# ---------------------------------------------------------------------------

# compose가 app 컨테이너를 호스트에 노출하는 포트. 컨테이너 안의 listen 포트는
# 3000 고정이다. 호스트에서 직접 실행(pnpm --filter @cp949/storix-api start:dev)할
# 때의 listen 포트는 STORIX_PORT로 바꾼다(기본 3000, 컨테이너 실행에서는 무시).
# host Nginx만 app에 접근시키는 배포 시나리오는 STORIX_PUBLISH_HOST=127.0.0.1로
# 제한한다. 기본값 0.0.0.0은 기존 compose 동작을 유지한다.
STORIX_PUBLISH_HOST=0.0.0.0
STORIX_PUBLISH_PORT=3000
#STORIX_PORT=3000

# --- DB 접속 정보 ---
# postgres(기본) 또는 sqlite. sqlite면 아래 STORIX_DB_HOST 등은 무시되고
# STORIX_DB_SQLITE_PATH만 쓰인다.
# sqlite는 단일 프로세스 all-in-one 배포 전제로 gc/backup/restore 포함 전체
# 검증됐다. docker-compose에서는 docker-compose.sqlite.yml을 겹친다 — 상세는
# README.sqlite.md.
STORIX_DB_DRIVER=postgres
# STORIX_DB_DRIVER=sqlite일 때 필수. sqlite 파일 경로(예: /data/storix.sqlite).
STORIX_DB_SQLITE_PATH=
# 외부 Postgres 호스트를 넣는다. docker-compose.postgres.yml을 겹치면 컨테이너
# 쪽 STORIX_DB_HOST/STORIX_DB_PORT는 postgres:5432로 재정의되고, 아래 두 값은 호스트에서
# 직접 실행하는 API 서버(pnpm --filter @cp949/storix-api start:dev)·psql이 127.0.0.1:STORIX_DB_PORT로 노출된 그
# 컨테이너에 접속하는 데 쓰인다. 여러 WAS 인스턴스가 하나의 Postgres를
# 공유하는 배포(docs/deployment/multi-instance-versitygw.md)에서는 모든
# 호스트의 STORIX_DB_HOST에 같은 전용 DB 호스트를 넣는다.
STORIX_DB_HOST=localhost
STORIX_DB_PORT=5432
STORIX_DB_USERNAME=storix
STORIX_DB_PASSWORD=storix
STORIX_DB_NAME=storix

# --- 스토리지 접속 정보 (S3 호환, ADR-0012) ---
# 어떤 조합에서 어떤 값이 실제로 쓰이는지:
#   versitygw override        ENDPOINT/PORT/USE_SSL은 override가 재정의(아래 값
#                             무시). ACCESS_KEY/SECRET_KEY/BUCKET은 app 접속용이자
#                             컨테이너의 root 자격증명·초기 버킷 이름.
#   s3 override               ENDPOINT/PORT/USE_SSL/PATH_STYLE/PUBLIC_*을 override가
#                             AWS 값으로 고정. REGION/ACCESS_KEY/SECRET_KEY/BUCKET만
#                             실제 발급값으로 채운다(사전 준비는 그 파일 상단 주석).
#   base 단독(외부 S3 호환)   전부 그대로 사용.
STORIX_STORAGE_ENDPOINT=localhost
STORIX_STORAGE_PORT=9000
STORIX_STORAGE_USE_SSL=false
STORIX_STORAGE_ACCESS_KEY=storix
STORIX_STORAGE_SECRET_KEY=storix-secret
STORIX_STORAGE_BUCKET=storix
# VersityGW/self-host 기본값 true(path-style). AWS S3(virtual-hosted-style)는
# docker-compose.s3.yml이 false로 고정한다.
STORIX_STORAGE_PATH_STYLE=true
# 비우면 us-east-1. 백엔드가 리전을 지정해 운영되면(AWS S3 버킷 리전, VersityGW --region) 같은 값을 넣는다.
STORIX_STORAGE_REGION=

# docker-compose.versitygw.yml 전용 — versitygw 볼륨 경로. 비워두면 named
# volume(versitygw-data)을 쓴다. NAS 마운트 경로(예: /mnt/nas/storix-data)를
# 주면 그 경로가 그대로 bind mount로 전환된다. 이 값은 모든 WAS 호스트에서
# 동일해야 한다 — 공유되는 건 NAS 데이터 자체이고, WAS별로 다른 건 그 경로를
# 바라보는 VersityGW 게이트웨이 컨테이너뿐이다(ADR-0003). 반드시 /로 시작하는
# 절대 경로로 설정한다 — 절대 경로가 아니면 Docker Compose가 bind mount가
# 아니라 named volume 이름으로 조용히 해석해, 오타(예: 맨 앞 / 누락)가 에러
# 없이 로컬 named volume을 새로 만드는 것으로 조용히 실패한다.
STORIX_VERSITYGW_DATA_PATH=

# presigned download URL 발급용 — 외부에서 접근 가능한 주소를 넣는다. 내부용
# STORIX_STORAGE_ENDPOINT와 같은 값을 쓰면 서명된 URL의 host가 내부 전용 이름이 되어
# 외부에서 못 찾는다(STORAGE-03의 nginx reverse-proxy 샘플과 짝을 이룬다).
STORIX_STORAGE_PUBLIC_ENDPOINT=
STORIX_STORAGE_PUBLIC_PORT=9000
STORIX_STORAGE_PUBLIC_USE_SSL=false
# 개발·검증용 nginx reverse-proxy 샘플(docs/deployment/compose.nginx-demo.yml,
# Storix 필수 구성 아님)을 쓸 때만 필요 — 호스트에 노출할 포트.
STORIX_NGINX_PUBLIC_PORT=8443
# docs/deployment/scenarios/co-located-nginx-mtls 전용 — host Nginx가 loopback으로
# VersityGW에 접근할 포트다.
STORIX_SCENARIO_VERSITYGW_PORT=7070

# single-host-private 시나리오의 compose.secrets.yml이 읽는 호스트 비밀 파일 디렉터리.
#STORIX_SCENARIO_SECRETS_DIR=/etc/storix/secrets

# namespace별 파일 크기 override가 없을 때 적용하는 기본값. 양의 정수 byte다.
STORIX_DEFAULT_FILE_SIZE_BYTES=5368709120
# namespace 파일 크기 override의 ceiling. 비우면 기본값과 같다. S3 multipart 구조상한은 167772160000 bytes다.
STORIX_MAX_FILE_SIZE_BYTES=
STORIX_DEFAULT_MAX_FILES_PER_FOLDER=10000
STORIX_MAX_FILES_PER_FOLDER=
STORIX_DEFAULT_MAX_LIVE_NODES=1000000
STORIX_MAX_LIVE_NODES=
STORIX_MAX_SYNC_DELETE_NODES=1000
STORIX_MAX_SYNC_COPY_NODES=1000
# snapshot 하나를 생성할 때 캡처할 수 있는 최대 노드 수(디렉터리 포함)와
# 파일 크기의 논리적 합계(바이트). 기본값은 1000개, 5 GiB다.
STORIX_MAX_SYNC_SNAPSHOT_NODES=1000
STORIX_MAX_SNAPSHOT_BYTES=5368709120
# namespace 하나가 보존하는 모든 snapshot의 최대 노드 수와 논리적 파일 크기
# 합계(바이트). 기본값은 100000개, 50 GiB다. 같은 Blob을 여러 manifest가
# 참조하면 각 manifest 항목의 크기를 각각 계산한다. snapshot은 자동 만료되지
# 않으며 명시적으로 삭제해야 이 예산과 Blob 참조가 해제된다.
STORIX_MAX_RETAINED_SNAPSHOT_NODES=100000
STORIX_MAX_RETAINED_SNAPSHOT_BYTES=53687091200
# namespace 하나가 휴지통에 보존하는 삭제 node 수 상한. 기본 100000개다.
# 30일 만료 후 GC purge가 완료될 때까지 node 수와 논리 byte가 과금된다.
STORIX_MAX_RETAINED_TRASH_NODES=100000
# namespace별 quota override가 없을 때 적용하는 기본값. 양의 10진 byte다.
STORIX_DEFAULT_TOTAL_LOGICAL_BYTES=53687091200
# namespace quota override의 ceiling. 비우면 기본값과 같다.
STORIX_MAX_TOTAL_LOGICAL_BYTES=
# 선택 VFS capability 시작 설정 JSON 파일 경로. 비우면 모든 선택 capability가 비활성이다.
# 지정한 파일은 app 시작 시 읽으며 경로·JSON·schema 또는 namespace ID가 잘못되면 시작을 거부한다.
# 등록된 선택 capability는 resumable-upload와 change-feed(둘 다 기본 비활성)이며 미등록 ID는 시작 오류다.
STORIX_VFS_CAPABILITIES_CONFIG_PATH=
# 변경 feed journal 보존 기간(일). 기본 30일이며 GC가 DB 시각 기준으로 만료 이벤트를
# 정리한다. 양의 정수만 허용한다. 오래된 cursor는 410이며 전체 열거부터 다시 시작한다.
STORIX_VFS_CHANGE_RETENTION_DAYS=30
# 재개 업로드 정책 JSON 경로. capability를 전역 또는 namespace에 허용하면 필수다.
# global.maxStagedBytes(양의 10진 문자열)·maxActiveSessions(양의 정수),
# namespaces.<UUID>별 같은 두 한도가 필수다. 선택 global.partSizeBytes=16777216,
# inactivitySeconds=86400, maxLifetimeSeconds=604800. 추가 필드·무한 한도는 거부한다.
# 유효한 JSON 예시와 활성 순서는 README 환경변수 절을 참고한다.
STORIX_VFS_UPLOAD_SESSIONS_CONFIG_PATH=
# namespace별 snapshot 한도 재정의는 전역값보다 낮게만 적용된다.
STORIX_MUTATION_LEASE_SECONDS=60
STORIX_MUTATION_MAX_UPLOAD_SECONDS=86400
# 새 FILE에 지정하는 X-Expires-In의 최소/최대 초. 양의 안전 정수이며 MIN <= MAX.
# MAX는 PostgreSQL INTEGER 저장 범위 때문에 2147483647초 이하여야 한다.
STORIX_VFS_EXPIRY_MIN_SECONDS=60
STORIX_VFS_EXPIRY_MAX_SECONDS=2592000
# presigned download URL 만료 시간(초). 기본 300초. SigV4 상한인
# 604800초(7일)를 초과하면 API 서버가 부팅 시 오류를 내며 종료된다.
STORIX_PRESIGNED_URL_EXPIRY_SECONDS=300
STORIX_ORPHAN_GRACE_PERIOD=86400
# 멀티 인스턴스 배치에서 gc 중복 실행을 막는 최소 재실행 간격(초). 이 시간 안에
# 다른 인스턴스가 이미 완료했으면 스캔·삭제를 건너뛴다.
STORIX_GC_MIN_INTERVAL=3600
# gc가 한 실행에서 단계마다 처리하는 행 수 예산. 소진된 단계는 재개 위치를 저장하고
# 다음 실행에서 이어간다. 단위는 단계가 정한다(change feed 정리는 읽은 만료 이벤트 수).
STORIX_GC_MAX_ROWS_PER_STAGE=200000
# 삭제가 끝난(DELETED) namespace의 행을 gc가 물리 삭제하기까지의 보존 기간(일). 삭제 상태 조회와
# 같은 key의 삭제 재요청 재생은 이 기간 안에서만 된다. 물리 삭제는 되돌릴 수 없다.
STORIX_NAMESPACE_DELETED_RETENTION_DAYS=30

# 서비스 간 인증 — openssl rand -hex 32 로 생성한 값을 사용한다.
STORIX_API_KEY=
# 키 로테이션 중에만 설정한다 — 이 값과 STORIX_API_KEY 둘 다 유효한 키로 인정된다.
# 값을 바꾸면 app을 재시작해야 반영된다.
STORIX_API_KEY_PREVIOUS=
# quota 관리 endpoint 전용 키. 일반 저장 API 키와 분리하고 필요할 때만 설정한다.
STORIX_ADMIN_API_KEY=
STORIX_ADMIN_API_KEY_PREVIOUS=

# ENCRYPTED namespace를 하나라도 쓰려면 필수. openssl rand -hex 32 로 생성한 값을 사용한다.
# 이 값을 분실하면 ENCRYPTED namespace의 데이터를 영구적으로 복호화할 수 없다.
STORIX_ENCRYPTION_MASTER_KEY=

# 설정하면 500 에러/GC job 실패를 Sentry로 리포팅한다(self-hosted Sentry/SaaS 둘 다
# DSN 방식으로 지원). 비워두면 아무 것도 하지 않는 NoopErrorReporter가 대신 쓰인다.
# 요청 헤더·바디·쿼리스트링은 전송하지 않는다(sendDefaultPii: false 고정).
STORIX_SENTRY_DSN=
# Prometheus 메트릭(/metrics)은 /health와 동일하게 무인증·상시 노출되며 끄고 켜는
# env var가 없다.

# 통신형 비밀값 어댑터 패키지 이름(쉼표 구분). 사용자 이미지에 설치한 bare 패키지만 지정한다.
#STORIX_SECRET_ADAPTERS=
# 통신형 비밀값 해석 1건의 타임아웃(ms).
#STORIX_SECRET_RESOLVE_TIMEOUT_MS=10000

# 백업 대상 로컬 디렉터리 — profiles: ['backup']로 backup 서비스를 실행할 때
# 사용한다. 실행마다 {STORIX_BACKUP_DIR}/{ISO8601 타임스탬프}/ 아래에 postgres.dump +
# blobs/ 미러를 남긴다. 오프호스트 반출과 보존(retention) 관리는 운영자
# 책임이다(OPS-02 ADR 참고).
STORIX_BACKUP_DIR=/backups
# profiles: ['restore']로 restore 서비스를 실행할 때 필수 — 위 STORIX_BACKUP_DIR
# 아래 특정 백업 디렉터리(예: /backups/2026-09-08T12-00-00-000Z)를 가리킨다.
STORIX_RESTORE_SOURCE_DIR=
# 복구 대상에 이미 namespace 데이터가 있으면 restore가 기본적으로 거부한다.
# 의도적으로 덮어쓰려면 true로 설정한다 — 기존 Postgres 데이터와 스토리지 오브젝트가 전부
# 지워지고 백업 시점 상태로 교체된다(되돌릴 수 없음).
STORIX_RESTORE_FORCE=false
