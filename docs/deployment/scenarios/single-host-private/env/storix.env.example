# 이 파일을 비밀값 파일로 직접 쓰지 않는다.
# 값을 채운 사본을 소유자 root, 권한 0600으로 /etc/storix/storix.env에 둔다.
# 개발에서는 아래 값을 약한 값으로 바꿔도 되지만 운영 값을 복사하지 않는다.

# 서비스 인증. 생성: openssl rand -hex 32
STORIX_API_KEY=replace-with-random-api-key
STORIX_API_KEY_PREVIOUS=

# ENCRYPTED namespace를 쓰면 필수다. 생성: openssl rand -hex 32
# 데이터 볼륨·백업과 다른 위치에 별도로 보관한다.
# 키를 잃으면 ENCRYPTED 데이터를 복호화할 수 없다.
STORIX_ENCRYPTION_MASTER_KEY=

# VersityGW root 자격증명이자 Storix의 S3 자격증명이다.
STORIX_STORAGE_ACCESS_KEY=replace-with-versitygw-access-key
STORIX_STORAGE_SECRET_KEY=replace-with-secret
STORIX_STORAGE_BUCKET=storix
STORIX_STORAGE_PATH_STYLE=true
STORIX_STORAGE_REGION=us-east-1

# 비워 두면 presigned 다운로드가 비활성이다.
# 개인정보 파일은 Storix의 /download를 WAS가 중계하므로 설정하지 않는다.
STORIX_STORAGE_PUBLIC_ENDPOINT=

# 로컬 디스크(예: LUKS로 암호화한 마운트)의 경로. 비우면 named volume을 쓴다.
STORIX_VERSITYGW_DATA_PATH=

# 아래는 SQLite를 쓰면 무시된다. docker-compose.postgres.yml을 쓸 때만 필요하다.
STORIX_DB_USERNAME=replace-with-storix-db-user
STORIX_DB_PASSWORD=replace-with-secret
STORIX_DB_NAME=storix
