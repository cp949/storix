# A/B 노드에 실제 비밀값을 채워 별도 /etc/storix/storix.env로 배포한다.
STORIX_PUBLISH_HOST=127.0.0.1
STORIX_PUBLISH_PORT=3000

STORIX_DB_DRIVER=postgres
STORIX_DB_HOST=postgres.internal
STORIX_DB_PORT=5432
STORIX_DB_USERNAME=replace-with-storix-db-user
STORIX_DB_PASSWORD=replace-with-secret
STORIX_DB_NAME=storix

STORIX_STORAGE_ACCESS_KEY=replace-with-versitygw-access-key
STORIX_STORAGE_SECRET_KEY=replace-with-secret
STORIX_STORAGE_BUCKET=storage
STORIX_STORAGE_PATH_STYLE=true
STORIX_STORAGE_REGION=us-east-1
STORIX_STORAGE_PUBLIC_ENDPOINT=sample.com
STORIX_STORAGE_PUBLIC_PORT=443
STORIX_STORAGE_PUBLIC_USE_SSL=true
STORIX_SCENARIO_VERSITYGW_PORT=7070
STORIX_VERSITYGW_DATA_PATH=/mnt/nas/storix-data

STORIX_API_KEY=replace-with-random-api-key
STORIX_API_KEY_PREVIOUS=
STORIX_ENCRYPTION_MASTER_KEY=
