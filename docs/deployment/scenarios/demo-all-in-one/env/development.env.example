# 개발 전용 예시다. 운영 자격증명으로 사용하지 않는다.
STORIX_API_KEY=development-only-api-key-change-before-production
STORIX_ENCRYPTION_MASTER_KEY=

STORIX_STORAGE_ACCESS_KEY=storix-development
STORIX_STORAGE_SECRET_KEY=storix-development-secret
STORIX_STORAGE_BUCKET=storix-demo
STORIX_STORAGE_PATH_STYLE=true
STORIX_STORAGE_REGION=us-east-1

# presigned URL의 host:port는 Browser가 실제로 요청을 보내는 Nginx origin과
# 같아야 한다(Nginx의 /storix-demo/ location이 VersityGW로 그대로 전달하므로).
# Storix 컨테이너 자신(app:3000)을 넣으면 presigned-download 발급 자체가
# 500이 된다(STORIX_STORAGE_PUBLIC_ENDPOINT 미설정/오설정 시의 알려진 실패 모드).
STORIX_STORAGE_PUBLIC_ENDPOINT=localhost
STORIX_STORAGE_PUBLIC_PORT=8080
STORIX_STORAGE_PUBLIC_USE_SSL=false

# 업로드 상한 초과 케이스를 smoke test에서 실용적인 크기로 재현하기 위해
# 기본값(5GiB)보다 훨씬 작게 낮춘다 — 운영값을 복사하지 않는다.
STORIX_MAX_FILE_SIZE_BYTES=41943040

STORIX_VERSITYGW_DATA_PATH=

# Nginx가 호스트에 노출하는 포트(= proposal의 http://localhost:8080).
STORIX_SCENARIO_NGINX_PORT=8080
