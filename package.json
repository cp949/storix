{
  "name": "storix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "contract": "turbo run build --filter=@cp949/storix-api && node apps/contract/src/cli.ts"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  }
}
