{
  "name": "@cp949/storix-api",
  "version": "0.1.0",
  "description": "범용 VFS 저장 서버",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand",
    "test:integration:sqlite": "STORIX_DB_DRIVER=sqlite NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand '\\.sqlite\\.integration-spec\\.ts$'",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/persistence/data-source.ts",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/persistence/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/persistence/data-source.js",
    "gc:run": "pnpm build && node dist/gc-main.js",
    "gc:run:prod": "node dist/gc-main.js",
    "backup:run": "pnpm build && node dist/backup-main.js",
    "backup:run:prod": "node dist/backup-main.js",
    "restore:run": "pnpm build && node dist/restore-main.js",
    "restore:run:prod": "node dist/restore-main.js",
    "storage-put:admin": "pnpm build && node dist/storage/storage-put-admin.main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/lib-storage": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "@prometheus-io/client": "0.16.1",
    "@sentry/node": "10.73.0",
    "better-sqlite3": "^12.11.1",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
