{
  "name": "@storix/demo-was",
  "version": "0.1.0",
  "description": "Storix 공개 HTTP API만 사용하는 데모용 외부 소비자 WAS",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.18" },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "30.5.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
